# Maintainer: Anon5T4R <https://github.com/Anon5T4R>
pkgname=localoffice
pkgver=0.11.9
pkgrel=1
pkgdesc="Editor de texto local e open-source, escrito em Rust puro"
arch=('x86_64' 'aarch64')
url="https://github.com/Anon5T4R/local-office"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs' 'vulkan-driver' 'libxkbcommon' 'fontconfig' 'freetype2')
makedepends=('rust' 'clang' 'lld')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto')

build() {
  cd "$pkgname-$pkgver"
  CRAFT_FONTS_DIR="$srcdir/$pkgname-$pkgver/assets/craft-fonts" cargo build --locked --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/localoffice "$pkgdir/usr/bin/localoffice"
  install -Dm755 target/release/localoffice-cli "$pkgdir/usr/bin/localoffice-cli"
  install -Dm644 packaging/linux/com.local.localoffice.desktop \
    "$pkgdir/usr/share/applications/com.local.localoffice.desktop"
  install -Dm644 packaging/linux/com.local.localoffice.mime.xml \
    "$pkgdir/usr/share/mime/packages/com.local.localoffice.mime.xml"
  install -Dm644 assets/app-icon/hicolor/scalable/apps/com.local.localoffice.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.local.localoffice.svg"
}
