# PKGBUILD do localwriter para Arch (uso pessoal do João; não publicado no AUR).
# Instala a árvore FHS (bin/ + share/) do tarball da release — o mesmo artefato
# que o package.sh gera. O sha256 fica SKIP no repo (o hash só existe após a
# release); o job arch do CI substitui pelo real ao construir o pacote.
#
#   makepkg -si   (local, com o tarball da release ao lado)

pkgname=ai.storyteller.localwriter
pkgver=0.11.28
pkgrel=1
pkgdesc='Editor de texto local e open-source, escrito em Rust puro'
arch=(x86_64)
url='https://github.com/Styx-Studios/Local-Writer'
license=('MIT OR Apache-2.0')
# The product was called Local Word (package `ai.storyteller.localoffice`, provides `localoffice`).
provides=('localwriter' 'localoffice')
conflicts=('localwriter' 'localoffice' 'ai.storyteller.localoffice')
replaces=('ai.storyteller.localoffice' 'localoffice')
depends=(glibc gcc-libs libxcb libxrandr libxi libxcursor libxkbcommon)
optdepends=('xdg-desktop-portal: seletor nativo de arquivos (GNOME/KDE já trazem)')
options=(!debug)
source=("localwriter-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -dm755 "$pkgdir/usr"
  cp -a "localwriter-$pkgver-linux-x86_64/bin" "$pkgdir/usr/"
  cp -a "localwriter-$pkgver-linux-x86_64/share" "$pkgdir/usr/"
}
