<?xml version="1.0" encoding="utf-8"?>
<!--
  LocalOffice MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build localoffice.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... [-d Scope=perUserOrMachine] -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  Built a second time with -d Scope=perUserOrMachine for people without administrator rights
  (#39): a dual-purpose package that WiX gives ALLUSERS=2 and MSIINSTALLPERUSER=1, so it installs
  for the current user with no UAC prompt. Windows then redirects Program Files to
  %LOCALAPPDATA%\Programs, the Start Menu to the user's own, and HKMU to HKCU, so the same
  components work in both packages. Both share the UpgradeCode: each upgrades its own earlier
  versions (Windows Installer only matches products installed in the same context).

  UpgradeCode and the component GUIDs below belong to LocalOffice alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<?ifndef Scope?>
<?define Scope = perMachine?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="LocalOffice"
Manufacturer="LocalOffice contributors"
      Version="$(var.Version)"
      UpgradeCode="075497F9-E861-45D0-9C7F-A74F8C34E6BA"
      Scope="$(var.Scope)"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="LocalOffice word processor" Manufacturer="LocalOffice contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of LocalOffice is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LocalOfficeIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LocalOfficeIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Anon5T4R/local-office" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Anon5T4R/local-office/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Anon5T4R/local-office/issues" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch LocalOffice (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch LocalOffice" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LocalOfficeExe]" />
    <CustomAction Id="LaunchLocalOffice" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLocalOffice"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LocalOffice" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="LocalOffice" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="LocalOfficeFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="LocalOfficeFiles" Directory="INSTALLFOLDER">
      <Component Id="LocalOfficeApp" Guid="855DCEC6-9285-444F-9382-9654B83B34F6">
        <File Id="LocalOfficeExe" Source="$(var.BinDir)\localoffice.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="LocalOffice"
              Description="LocalOffice word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LocalOfficeIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\localoffice.exe" Value="[#LocalOfficeExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a LocalOffice ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so LocalOffice shows in
           Explorer's "Open with". The Word, RTF and ODT types are also LocalOffice's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="LocalOfficeFileTypes" Guid="EFF89E6A-F9B8-49F9-B3AE-E243347484B4">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="LocalOffice" Value="Software\LocalOffice\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities" Name="ApplicationName" Value="LocalOffice" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities" Name="ApplicationIcon" Value="&quot;[#LocalOfficeExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe" Name="FriendlyAppName" Value="LocalOffice" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="LocalOffice.Document" Description="Word Document" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.Document\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="LocalOffice.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".docx" Value="LocalOffice.Document" Type="string" />

        <ProgId Id="LocalOffice.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.DocumentMacroEnabled\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docm\OpenWithProgids" Name="LocalOffice.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".docm" Value="LocalOffice.DocumentMacroEnabled" Type="string" />

        <ProgId Id="LocalOffice.Template" Description="Word Template" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.Template\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotx\OpenWithProgids" Name="LocalOffice.Template" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".dotx" Value="LocalOffice.Template" Type="string" />

        <ProgId Id="LocalOffice.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.TemplateMacroEnabled\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotm\OpenWithProgids" Name="LocalOffice.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".dotm" Value="LocalOffice.TemplateMacroEnabled" Type="string" />

        <ProgId Id="LocalOffice.LegacyDocument" Description="Legacy Word Document" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.LegacyDocument\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.doc\OpenWithProgids" Name="LocalOffice.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".doc" Value="LocalOffice.LegacyDocument" Type="string" />

        <ProgId Id="LocalOffice.LegacyTemplate" Description="Legacy Word Template" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.LegacyTemplate\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dot\OpenWithProgids" Name="LocalOffice.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".dot" Value="LocalOffice.LegacyTemplate" Type="string" />

        <ProgId Id="LocalOffice.RichText" Description="Rich Text Document" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.RichText\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.rtf\OpenWithProgids" Name="LocalOffice.RichText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".rtf" Value="LocalOffice.RichText" Type="string" />

        <ProgId Id="LocalOffice.OpenDocumentText" Description="OpenDocument Text" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.OpenDocumentText\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.odt\OpenWithProgids" Name="LocalOffice.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LocalOffice\Capabilities\FileAssociations" Name=".odt" Value="LocalOffice.OpenDocumentText" Type="string" />

        <ProgId Id="LocalOffice.Markdown" Description="Markdown Document" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.Markdown\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="LocalOffice.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="LocalOffice.PlainText" Description="Text Document" Icon="LocalOfficeExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalOffice.PlainText\shell\open\command" Value="&quot;[#LocalOfficeExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="LocalOffice.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localoffice.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="LocalOfficeCli">
        <File Id="LocalOfficeCliExe" Source="$(var.BinDir)\localoffice-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
